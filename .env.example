# Router Control — copy to .env.local and fill in values.
# .env.local is gitignored. Do not commit real credentials.

# Router admin interface (Dialog 4G CPE default)
ROUTER_URL=http://192.168.8.1

# Default username on Dialog CPE firmware
ROUTER_USERNAME=user

# Required — set your router admin password
ROUTER_PASSWORD=

# Optional — shown in the dashboard header (host/IP only, no protocol)
# NEXT_PUBLIC_ROUTER_URL=192.168.8.1

# --- Set automatically by Electron in packaged builds; usually omit in dev ---
# APP_DATA_DIR=
# DB_PATH=
# ELECTRON_DEV=1
